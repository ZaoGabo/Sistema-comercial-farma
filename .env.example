# URL base de la API REST (Capa 2) alojada en la PC de Base de Datos
VITE_API_URL=http://192.168.21.107:3000/api

# Datos del inquilino (multi-tenant) mostrados en el Tenant Switcher
VITE_TENANT_NOMBRE=Corporación Andina S.A.
VITE_TENANT_PLAN=Plan Enterprise

# Formato regional y moneda
VITE_LOCALE=es-EC
VITE_MONEDA=USD

# Parametros tributarios y laborales usados solo para estimaciones en formularios.
# El calculo definitivo lo realizan los procedimientos almacenados de Oracle.
VITE_IVA_PORCENTAJE=15
VITE_IESS_PERSONAL_PORCENTAJE=9.45

# Monto desde el cual una orden pendiente se considera de alto valor
VITE_UMBRAL_ALTO_VALOR=150000

# Metodos de pago ofrecidos en el formulario de Contabilidad (separados por coma)
VITE_METODOS_PAGO=TRANSFERENCIA,CHEQUE,EFECTIVO

# Intervalo de verificacion de la API (GET /api/salud) en segundos
VITE_INTERVALO_SALUD_SEG=30
